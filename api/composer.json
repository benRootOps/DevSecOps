{
  "name": "nexachat/backend",
  "description": "NexaChat - Backend Laravel API",
  "keywords": [
    "laravel",
    "chat",
    "realtime"
  ],
  "license": "MIT",
  "require": {
    "php": "^8.2.4",
    "laravel/framework": "^11.0",
    "laravel/sanctum": "^4.0",
    "laravel/tinker": "^2.9",
    "pusher/pusher-php-server": "^7.2",
    "intervention/image": "^3.0",
    "league/flysystem-aws-s3-v3": "^3.0",
    "laravel/reverb": "^1.0",
    "tymon/jwt-auth": "*"
  },
  "require-dev": {
    "fakerphp/faker": "^1.23",
    "laravel/pint": "^1.13",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.0",
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "post-install-cmd": [
      "@php artisan key:generate --ansi"
    ]
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
